   "fieldname": "acknowledge_required",
   "fieldtype": "Check",
   "label": "Require acknowledgement",
   "default": "0",
   "description": "Adds an 'I've read and understood this' button, and keeps the card on the employee's Home until they press it. For policies and safety notices, not for a canteen closure."
